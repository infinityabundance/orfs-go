{
  "schema": "orfs.performance.transport.v1",
  "note": "honest F0-vs-alternative transport comparison; a transport that is not available is named, never faked",
  "probe": {
    "schema": "orfs.transport.probe.v1",
    "support": {
      "kernel_release": "7.2.9-2-cachyos",
      "kernel_compiled_in": true,
      "kernel_enabled": true,
      "kernel_param_path": "/sys/module/fuse/parameters/enable_uring",
      "kernel_param_value": "Y",
      "library": "github.com/hanwen/go-fuse/v2",
      "library_version": "v2.12.0",
      "library_exposes_transport": false,
      "available": false,
      "reason": "the linked FUSE library (github.com/hanwen/go-fuse/v2 v2.12.0) exposes no FUSE-over-io_uring transport: it only names the capability bit (fuse/types.go:325 CAP_OVER_IO_URING, printed at fuse/print.go:58) and serves through a read(2)/writev(2) loop on /dev/fuse"
    },
    "negotiation": {
      "kernel_release": "7.2.9-2-cachyos",
      "mounted": true,
      "kernel_major": 7,
      "kernel_minor": 45,
      "kernel_flags": 262144,
      "kernel_flags2": 1946157051,
      "kernel_advertises_io_uring": true,
      "control_request_on_dev_fuse": true,
      "uring_reply_request_on_dev_fuse": false,
      "note": "control = INIT replied without FUSE_OVER_IO_URING; test = INIT replied with FUSE_OVER_IO_URING. A request ceasing to arrive on /dev/fuse is the observational signature of an io_uring connection; it is evidence, not a completed io_uring REGISTER (this build performs no unsafe pointer syscalls)."
    }
  },
