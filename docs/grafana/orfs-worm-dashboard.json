{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "Authoritative retained bytes (or.log/*.seg + commit.watermark) versus the derived manifested plane (.or_bloom/), the logical regular-file bytes, and the committed root R. All are emitted by `orfs metrics`.",
      "fieldConfig": {
        "defaults": { "unit": "bytes" },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "amplification" },
            "properties": [{ "id": "unit", "value": "short" }]
          }
        ]
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "id": 1,
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "orfs_physical_bytes", "legendFormat": "physical (authoritative retained)", "refId": "A" },
        { "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "orfs_authoritative_bytes", "legendFormat": "committed root R", "refId": "B" },
        { "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "orfs_logical_bytes", "legendFormat": "logical file bytes", "refId": "C" },
        { "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "orfs_manifested_bytes", "legendFormat": "manifested (.or_bloom)", "refId": "D" }
      ],
      "title": "Authoritative vs manifested bytes",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "Authoritative committed root divided by logical regular-file bytes. >= 1 is the framing/retention tax of append-only history; it is emitted as 0 when the volume holds no regular-file bytes.",
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 3 }, "overrides": [] },
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 0 },
      "id": 2,
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "single" } },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "orfs_amplification_ratio", "legendFormat": "amplification (root / logical)", "refId": "A" }
      ],
      "title": "Amplification ratio",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "Durability-barrier (fsync) latency, a bounded fixed-bucket estimate. p50 and p99 come from the persisted per-run snapshot written by `orfs mount`.",
      "fieldConfig": { "defaults": { "unit": "s", "decimals": 9 }, "overrides": [] },
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 0 },
      "id": 3,
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "single" } },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "orfs_fsync_latency_seconds{quantile=\"0.5\"}", "legendFormat": "p50", "refId": "A" },
        { "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "orfs_fsync_latency_seconds{quantile=\"0.99\"}", "legendFormat": "p99", "refId": "B" }
      ],
      "title": "Durability barrier latency p50 / p99",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "Group-commit batch size in transactions per barrier; last and average. A single sequential writer yields 1.",
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 2 }, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 8 },
      "id": 4,
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "single" } },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "orfs_group_commit_batch_size{stat=\"last\"}", "legendFormat": "last batch", "refId": "A" },
        { "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "orfs_group_commit_batch_size{stat=\"avg\"}", "legendFormat": "avg batch", "refId": "B" }
      ],
      "title": "Group-commit batch size",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "Per-second rate of capacity-guard admission refusals by reason (a counter, so rate() is valid). A refusal denies growth before the first byte (Law I). The read-only latch is orfs_degraded.",
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 8 },
      "id": 5,
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "single" } },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "rate(orfs_breach_total[5m])", "legendFormat": "breach/s {{reason}}", "refId": "A" }
      ],
      "title": "Capacity breaches (refusals)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "Per-second rate of retained abandoned-tail segments/bytes moved into or.log/quarantine/ by recovery (a counter, so rate() is valid; recovery MOVES, never truncates).",
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 8 },
      "id": 6,
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "single" } },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "rate(orfs_quarantine_total[5m])", "legendFormat": "quarantine/s {{unit}}", "refId": "A" }
      ],
      "title": "Quarantined tails",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "Failed checks from the most recent `orfs metrics` verify --deep pass.",
      "fieldConfig": { "defaults": { "unit": "short", "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 1 } ] } }, "overrides": [] },
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 16 },
      "id": 7,
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "orfs_verify_deep_failures", "legendFormat": "failures", "refId": "A" }
      ],
      "title": "verify --deep failures",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "1 when the volume has latched read-only (a capacity degradation), else 0.",
      "fieldConfig": { "defaults": { "unit": "short", "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 1 } ] } }, "overrides": [] },
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 16 },
      "id": 8,
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "orfs_degraded", "legendFormat": "degraded", "refId": "A" }
      ],
      "title": "Read-only latch (degraded)",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "Unix time the persisted runtime snapshot (metrics.json beside volume.meta) was captured by `orfs mount`, when a snapshot is present.",
      "fieldConfig": { "defaults": { "unit": "dateTimeAsIso" }, "overrides": [] },
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 16 },
      "id": 9,
      "options": { "colorMode": "none", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "orfs_metrics_snapshot_timestamp_seconds", "legendFormat": "snapshot", "refId": "A" }
      ],
      "title": "Runtime snapshot captured",
      "type": "stat"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["orfs", "worm", "append-only"],
  "templating": {
    "list": [
      {
        "current": {},
        "hide": 0,
        "includeAll": false,
        "label": "Prometheus",
        "multi": false,
        "name": "DS_PROMETHEUS",
        "options": [],
        "query": "prometheus",
        "refresh": 1,
        "regex": "",
        "skipUrlSync": false,
        "type": "datasource"
      }
    ]
  },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "OrFS WORM audit-log sink",
  "uid": "orfs-worm",
  "version": 1,
  "weekStart": ""
}
